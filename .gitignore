**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.gz
**/*.bz2
**/*.xz
**/*.7z
**/*.rar

# Local databases and runtime process files
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
**/*.pid
**/*.sock
**/*.log

# ZaoFu runtime state and repeatable workflow projections
**/.zf*/
