{
  "schema_version": "scenarioforge.authoring/v1",
  "title": "Crosswalk approach with a braking lead vehicle",
  "description": "A backend-independent authoring example covering vehicles, a pedestrian, an obstacle, an event, constraints and a sampled parameter.",
  "seed": 17,
  "road": {
    "topology_kind": "intersection",
    "coordinate_system": "right-handed-x-forward-y-left",
    "units": {
      "distance": "m",
      "speed": "m/s",
      "heading": "deg",
      "time": "s"
    },
    "lanes": [
      {
        "id": "approach",
        "kind": "travel",
        "length_m": 100.0,
        "width_m": 3.5,
        "speed_limit_mps": 16.0,
        "centerline": [
          {"x_m": 0.0, "y_m": 0.0},
          {"x_m": 100.0, "y_m": 0.0}
        ],
        "predecessor_lane_ids": [],
        "successor_lane_ids": ["exit"]
      },
      {
        "id": "exit",
        "kind": "travel",
        "length_m": 100.0,
        "width_m": 3.5,
        "speed_limit_mps": 16.0,
        "centerline": [
          {"x_m": 100.0, "y_m": 0.0},
          {"x_m": 200.0, "y_m": 0.0}
        ],
        "predecessor_lane_ids": ["approach"],
        "successor_lane_ids": []
      },
      {
        "id": "crosswalk",
        "kind": "crosswalk",
        "length_m": 12.0,
        "width_m": 4.0,
        "speed_limit_mps": 2.0,
        "centerline": [
          {"x_m": 75.0, "y_m": -6.0},
          {"x_m": 75.0, "y_m": 6.0}
        ],
        "predecessor_lane_ids": [],
        "successor_lane_ids": []
      }
    ],
    "conflict_zones": [
      {
        "id": "crosswalk-conflict",
        "lane_ids": ["approach", "crosswalk"],
        "polygon": [
          {"x_m": 72.0, "y_m": -3.0},
          {"x_m": 78.0, "y_m": -3.0},
          {"x_m": 78.0, "y_m": 3.0},
          {"x_m": 72.0, "y_m": 3.0}
        ]
      }
    ]
  },
  "routes": [
    {
      "id": "ego-route",
      "kind": "vehicle",
      "lane_ids": ["approach", "exit"],
      "goal": {"lane_id": "exit", "longitudinal_m": 90.0}
    },
    {
      "id": "lead-route",
      "kind": "vehicle",
      "lane_ids": ["approach"],
      "goal": {"lane_id": "approach", "longitudinal_m": 90.0}
    },
    {
      "id": "crosswalk-route",
      "kind": "pedestrian",
      "lane_ids": ["crosswalk"],
      "goal": {"lane_id": "crosswalk", "longitudinal_m": 10.0}
    }
  ],
  "actors": [
    {
      "id": "ego",
      "kind": "vehicle",
      "role": "ego",
      "dimensions": {"length_m": 4.8, "width_m": 1.9, "height_m": 1.6},
      "spawn": {
        "lane_id": "approach",
        "longitudinal_m": 10.0,
        "lateral_m": 0.0,
        "speed_mps": 12.0,
        "heading_deg": 0.0
      },
      "route_id": "ego-route",
      "behavior": {"profile": "deterministic"}
    },
    {
      "id": "lead",
      "kind": "vehicle",
      "role": "social",
      "dimensions": {"length_m": 4.5, "width_m": 1.8, "height_m": 1.5},
      "spawn": {
        "lane_id": "approach",
        "longitudinal_m": 45.0,
        "lateral_m": 0.0,
        "speed_mps": 10.0,
        "heading_deg": 0.0
      },
      "route_id": "lead-route",
      "behavior": {"profile": "conservative"}
    },
    {
      "id": "pedestrian",
      "kind": "pedestrian",
      "role": "vulnerable_road_user",
      "dimensions": {"length_m": 0.5, "width_m": 0.5, "height_m": 1.7},
      "spawn": {
        "lane_id": "crosswalk",
        "longitudinal_m": 2.0,
        "lateral_m": 0.0,
        "speed_mps": 1.2,
        "heading_deg": 90.0
      },
      "route_id": "crosswalk-route",
      "behavior": {"profile": "walking"}
    }
  ],
  "static_obstacles": [
    {
      "id": "exit-barrier",
      "kind": "barrier",
      "lane_id": "exit",
      "longitudinal_m": 70.0,
      "lateral_m": 1.5,
      "dimensions": {"length_m": 2.0, "width_m": 0.5, "height_m": 1.0}
    }
  ],
  "environment": {
    "weather": "clear",
    "time_of_day": "day",
    "road_surface": "dry",
    "visibility_m": 500.0
  },
  "events": [
    {
      "id": "lead-brakes",
      "sequence": 0,
      "actor_id": "lead",
      "trigger": {"kind": "simulation_time", "time_s": 4.0},
      "action": {"kind": "vehicle_control", "throttle_brake": -0.8, "steering": 0.0}
    }
  ],
  "constraints": {
    "duration_s": 30.0,
    "collision_is_failure": true,
    "success_conditions": [
      {
        "id": "ego-arrives",
        "kind": "route_completed",
        "actor_ids": ["ego"],
        "route_id": "ego-route",
        "threshold": null
      }
    ],
    "failure_conditions": [
      {
        "id": "vehicle-collision",
        "kind": "collision",
        "actor_ids": ["ego", "lead"],
        "route_id": null,
        "threshold": null
      }
    ],
    "safety": {
      "minimum_separation_m": 1.0,
      "max_deceleration_mps2": 10.0
    }
  },
  "parameters": [
    {
      "id": "lead-start",
      "target_path": "$.actors[1].spawn.longitudinal_m",
      "value_type": "number",
      "distribution": {"kind": "uniform", "minimum": 40.0, "maximum": 50.0}
    }
  ],
  "policy": {
    "id": "scenarioforge.deterministic-control",
    "version": "2.0.0",
    "config": {"target_speed_mps": 12.0}
  },
  "required_capabilities": [
    "actor.pedestrian",
    "actor.vehicle",
    "event.time-trigger",
    "road.intersection",
    "route.stable-id"
  ]
}
