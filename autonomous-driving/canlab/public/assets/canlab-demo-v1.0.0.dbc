 SG_ VehicleSpeed : 16|16@1+ (0.01,0) [0|655.35] "km/h" CANLAB
 SG_ ThrottlePosition : 32|8@1+ (0.4,0) [0|100] "%" CANLAB
 SG_ BrakePressure : 40|8@1+ (0.5,0) [0|127.5] "bar" CANLAB
 SG_ SelectedGear : 48|8@1+ (1,0) [0|3] "" CANLAB
 SG_ TurnIndicator : 56|8@1+ (1,0) [0|3] "" CANLAB

