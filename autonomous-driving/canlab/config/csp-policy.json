{
  "schema_version": "canlab.csp-policy.v1",
  "policy_version": "1.0.0",
  "header_name": "Content-Security-Policy",
  "directives": {
    "default-src": ["'self'"],
    "script-src": ["'self'"],
    "style-src": ["'self'", "'unsafe-inline'"],
    "img-src": ["'self'", "data:"],
    "font-src": ["'self'"],
    "connect-src": ["'self'"],
    "object-src": ["'none'"],
    "base-uri": ["'none'"],
    "frame-ancestors": ["'none'"],
    "frame-src": ["'none'"],
    "worker-src": ["'none'"],
    "form-action": ["'none'"]
  },
  "delivery": {
    "transport": "http-response-header",
    "host_scope": "loopback-only",
    "meta_policy_allowed": false
  }
}
