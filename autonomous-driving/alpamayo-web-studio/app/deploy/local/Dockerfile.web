FROM node:24-alpine AS build

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci
COPY next-env.d.ts next.config.ts tsconfig.json ./
COPY backend ./backend
COPY packages ./packages
COPY src ./src
COPY web ./web
ARG ALPAMAYO_STUDIO_API_ORIGIN=http://studio:8000
ENV ALPAMAYO_STUDIO_API_ORIGIN=${ALPAMAYO_STUDIO_API_ORIGIN}
RUN npm run build

FROM node:24-alpine AS runtime
WORKDIR /workspace
ENV NODE_ENV=production
COPY --from=build /workspace/.next/standalone ./
COPY --from=build /workspace/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
