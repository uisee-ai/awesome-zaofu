FROM python:3.12-slim

WORKDIR /workspace
COPY backend/pyproject.toml /workspace/backend/pyproject.toml
COPY backend/studio /workspace/studio
COPY fixtures /workspace/fixtures
COPY e2e/studio/fixtures /workspace/e2e/studio/fixtures
RUN pip install --no-cache-dir fastapi==0.118.0 pydantic==2.12.5 python-multipart==0.0.20 uvicorn==0.37.0

ENV PYTHONPATH=/workspace
ENV ALPAMAYO_STUDIO_APP_ROOT=/workspace
EXPOSE 8000
CMD ["uvicorn", "studio.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
