{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highwaypilot.local/schemas/construction-config/v1.schema.json",
  "title": "construction-config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "seed"],
  "properties": {
    "schema_version": {"const": "construction-config/v1"},
    "scenario_id": {"const": "construction-v0"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "road": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lanes_count": {"type": "integer", "minimum": 2, "maximum": 5},
        "lane_width_m": {"type": "number", "exclusiveMinimum": 0},
        "length_m": {"type": "number", "exclusiveMinimum": 0},
        "speed_limit_mps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "construction": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "side": {"enum": ["left", "right"]},
        "closed_lane_index": {"type": "integer", "minimum": 0, "maximum": 4},
        "target_lane_index": {"type": "integer", "minimum": 0, "maximum": 4},
        "zone_start_m": {"type": "number", "minimum": 0},
        "zone_end_m": {"type": "number", "exclusiveMinimum": 0},
        "warning_offsets_m": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
        "cone_spacing_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "ego": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "initial_position_m": {"type": "number", "minimum": 0},
        "initial_speed_mps": {"type": "number", "minimum": 0}
      }
    },
    "traffic": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "vehicles_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "min_speed_mps": {"type": "number", "minimum": 0},
        "max_speed_mps": {"type": "number", "minimum": 0},
        "density": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
        "aggressive_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "scenario_events": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dangerous_cut_in": {"type": "boolean"},
        "cut_in_trigger_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "cut_in_vehicle_speed_mps": {"type": "number", "minimum": 0}
      }
    },
    "simulation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "simulation_frequency_hz": {"type": "integer", "minimum": 1, "maximum": 120},
        "policy_frequency_hz": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "vehicles_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["presence", "x", "y", "vx", "vy", "heading"]}},
        "absolute": {"type": "boolean"},
        "normalize": {"type": "boolean"},
        "order": {"enum": ["sorted", "shuffled"]}
      }
    },
    "reward": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "collision": {"type": "number", "maximum": 0},
        "speed": {"type": "number"},
        "safe_lane": {"type": "number", "minimum": 0},
        "lane_change": {"type": "number", "maximum": 0},
        "merge_success": {"type": "number", "minimum": 0},
        "ttc": {"type": "number", "maximum": 0},
        "comfort": {"type": "number", "maximum": 0}
      }
    }
  }
}
